# ==============================================================================
# Sentry Configuration
# ==============================================================================
# The Sentry DSN (Data Source Name) for error tracking.
# Get this from Sentry: Project Settings -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn-here@o000000.ingest.sentry.io/0000000

# Optional: Sentry build-time source maps upload (for CI/CD or production builds)
# SENTRY_ORG=your-organization-slug
# SENTRY_PROJECT=your-project-slug
# SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here

# ==============================================================================
# User Behavior & Analytics Tracking
# ==============================================================================
# Google Analytics 4 Measurement ID (Format: G-XXXXXXXXXX)
# Get this from: Google Analytics -> Admin -> Data Streams -> Web -> Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Microsoft Clarity Project ID (Format: alphanumeric string, e.g. px9b8x2yz1)
# Get this from: https://clarity.microsoft.com -> Settings -> Overview -> Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=your_clarity_project_id_here
